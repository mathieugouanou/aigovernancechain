{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigovernancechain.com/schema/ai-governance.v0.1.json",
  "title": "AI_GOVERNANCE.md front matter (ai-governance/v0.1)",
  "description": "YAML front matter of an AI_GOVERNANCE.md file. Draft specification by AI Governance Chain, CC BY 4.0. Not legal advice.",
  "type": "object",
  "required": [
    "spec",
    "system",
    "roles",
    "jurisdictions",
    "uses"
  ],
  "properties": {
    "spec": {
      "const": "ai-governance/v0.1"
    },
    "system": {
      "type": "object",
      "required": [
        "name",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "description": "Accountable person, role or team (email or handle)."
        },
        "repository": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "provider",
          "deployer",
          "importer",
          "distributor",
          "product-manufacturer",
          "authorised-representative",
          "gpai-provider",
          "developer",
          "platform",
          "public-body",
          "employer",
          "any"
        ]
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,4}(-[A-Za-z]{2,3}){0,2}$"
      },
      "description": "EU, COE, US, US-CA, US-CO, US-TX, US-NY, US-NY-NYC, US-IL, CN, KR, JP, VN, IN, GB, SG, CH, or an EU member code such as DE."
    },
    "uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "any-ai",
          "chatbot",
          "agent",
          "generated-media",
          "deepfake",
          "emotion-recognition",
          "biometric-categorisation",
          "remote-biometric-id",
          "hiring",
          "credit",
          "insurance",
          "education",
          "essential-services",
          "healthcare",
          "law-enforcement",
          "migration",
          "justice",
          "critical-infrastructure",
          "significant-decision",
          "profiling",
          "recommender",
          "companion",
          "minors",
          "gpai-model",
          "frontier-model",
          "public-sector-use",
          "safety-component"
        ]
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "self_assessed": {
          "enum": [
            "minimal",
            "limited",
            "high",
            "unacceptable",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "model_card": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "description": "SPDX licence ID (for example Apache-2.0) or licence name."
          },
          "task": {
            "type": "string",
            "description": "What the model does in this system, for example text-generation or classification."
          },
          "datasets": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "license": {
                      "type": "string"
                    },
                    "contains_personal_data": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            "description": "Datasets used to train, fine-tune or evaluate the model (feeds aigovchain aibom)."
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "default_deny": {
          "type": "boolean",
          "default": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "scope"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "scope": {
                "enum": [
                  "read",
                  "write",
                  "payment",
                  "delete",
                  "send",
                  "execute",
                  "admin"
                ]
              },
              "limits": {
                "type": "object",
                "properties": {
                  "max_amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "max_calls": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "allowed_recipient_domains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "read_only": {
                    "type": "boolean",
                    "description": "Block queries that change data (INSERT, UPDATE, DELETE, DROP and similar)."
                  },
                  "allowed_tables": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Tables a query may touch. Any other table is blocked."
                  }
                },
                "additionalProperties": true
              },
              "approval": {
                "enum": [
                  "none",
                  "human",
                  "two-person"
                ]
              },
              "run_as": {
                "type": "string",
                "description": "The only identity this tool may run under (least privilege). Calls under any other identity are blocked."
              }
            }
          }
        },
        "spend_limit": {
          "type": "object",
          "required": [
            "amount"
          ],
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            },
            "period": {
              "enum": [
                "run",
                "hour",
                "day",
                "week",
                "month"
              ]
            }
          }
        },
        "kill_switch": {
          "type": "string",
          "description": "Who can stop the agent, how, and how fast."
        },
        "trust_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "treat_as"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "treat_as": {
                "enum": [
                  "data",
                  "instructions"
                ]
              }
            }
          }
        },
        "disclosure": {
          "type": "string",
          "description": "Fallback disclosure text; prefer controls.ai_disclosure.message."
        },
        "circuit_breaker": {
          "type": "object",
          "required": [
            "max_consecutive_errors"
          ],
          "properties": {
            "max_consecutive_errors": {
              "type": "integer",
              "minimum": 1,
              "description": "Open the breaker (block all tool calls) after this many failed calls in a row."
            }
          },
          "description": "Stops retry loops and cascading failures."
        },
        "memory": {
          "type": "object",
          "properties": {
            "write_sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Sources allowed to write to long-term memory, for example [user]. Writes from any other source are blocked."
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1,
              "description": "How long memory entries are kept."
            }
          },
          "description": "Long-term memory isolation and retention."
        },
        "manipulation_guard": {
          "type": "object",
          "properties": {
            "block": {
              "type": "array",
              "items": {
                "enum": [
                  "false_urgency",
                  "confirmshaming",
                  "exploit_vulnerability",
                  "false_scarcity"
                ]
              },
              "description": "Pressure tactics that outgoing messages may not use."
            }
          },
          "description": "Screens outgoing messages for manipulative tactics (see EU AI Act Art. 5(1)(a) and (b))."
        },
        "ci": {
          "type": "object",
          "required": [
            "workflows",
            "max_permissions"
          ],
          "properties": {
            "workflows": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Paths of the GitHub Actions workflows that run the agent, relative to the repository root."
            },
            "max_permissions": {
              "description": "The most the GITHUB_TOKEN may hold in those workflows, in GitHub's permissions syntax: read-all, or a map such as { contents: read, pull-requests: write }. Check 17 fails when a job grants more.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "read-all",
                    "write-all"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write",
                      "none"
                    ]
                  }
                }
              ]
            }
          },
          "description": "CI permissions the agent may use (optional, added 10 Nov 2026). Compared by check 17 with the workflow files."
        }
      }
    },
    "controls": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "ai_disclosure",
          "content_marking",
          "deepfake_label",
          "human_oversight",
          "tool_scope",
          "spend_limits",
          "kill_switch",
          "audit_log",
          "risk_management",
          "impact_assessment",
          "bias_testing",
          "data_governance",
          "technical_documentation",
          "incident_reporting",
          "transparency_notice",
          "contest_and_appeal",
          "ai_literacy",
          "prohibited_practices_screen",
          "registration",
          "local_representative",
          "safety_framework",
          "copyright_policy",
          "training_data_summary",
          "security_testing",
          "quality_management",
          "post_market_monitoring",
          "conformity_assessment",
          "accuracy_robustness",
          "privacy_compliance",
          "user_controls",
          "minors_protection",
          "content_moderation"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "enum": [
              "implemented",
              "partial",
              "planned",
              "not-applicable",
              "todo"
            ]
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "implemented",
                  "partial",
                  "planned",
                  "not-applicable",
                  "todo"
                ]
              },
              "how": {
                "type": "string"
              },
              "evidence": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "reason": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "due": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "items": {
                  "enum": [
                    "metadata",
                    "watermark",
                    "fingerprint",
                    "visible_label"
                  ]
                },
                "description": "Marking layers for content_marking."
              },
              "label": {
                "type": "string",
                "description": "Visible label text, used with the visible_label method."
              }
            }
          }
        ]
      }
    },
    "obligations": {
      "type": "object",
      "properties": {
        "acknowledged": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AGC-"
          }
        },
        "waived": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "governance": {
          "type": "string"
        },
        "security": {
          "type": "string"
        },
        "incidents": {
          "type": "string"
        },
        "dpo": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "last_reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "next_review": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "disclaimer": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
